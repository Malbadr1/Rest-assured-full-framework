{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "createdAt": { "type": "string" },
    "name": { "type": "string" },
    "avatar": { "type": "string", "format": "uri" },
    "username": { "type": "string" },
    "email": { "type": "string", "format": "email" },
    "status": { "type": "string" },
    "role": { "type": "string" }
  },
  "required": ["id", "name", "email", "username", "avatar", "status", "role", "createdAt"]
}
